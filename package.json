{
  "name": "macrosignals",
  "version": "0.1.1",
  "private": true,
  "description": "A local desktop workspace for macroeconomic indicators and market downturn research",
  "author": "MacroSignals",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:linux": "npm run build && electron-builder --linux dir --x64",
    "package:installer": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "node node_modules/electron/install.js",
    "build:web": "node scripts/build-web.mjs",
    "start:web": "node web/start.mjs",
    "dev:web": "npm run build:web && node web/server.mjs"
  },
  "build": {
    "appId": "local.macrosignals.desktop",
    "productName": "MacroSignals",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "core/**/*",
      "data/catalogue.json",
      "data/sources.json",
      "package.json",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MacroSignals-${version}-Windows-Setup.${ext}"
    },
    "linux": {
      "target": "dir",
      "category": "Finance"
    },
    "portable": {
      "artifactName": "MacroSignals-${version}-Windows.${ext}"
    },
    "asarUnpack": [
      "core/*.mjs"
    ]
  },
  "dependencies": {
    "d3": "7.9.0",
    "lucide-react": "1.45.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electron/asar": "3.4.1",
    "@types/d3": "7.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "typescript": "7.0.2"
  }
}
